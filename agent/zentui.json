{
  "icons": {
    "mode": "nerd"
  },
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "colorSource": "terminal",
      "styles": {
        "minimalist": {
          "variables": {
            "mode": "rx/mode"
          },
          "formats": {
            "topLeft": "",
            "topRight": "$session_name",
            "bottomRight": "$model$join_sep$thinking",
            "bottomLeft": "$mode"
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "compact"
    },
    "footer": {
      "style": "starship",
      "colorSource": "terminal",
      "enabled": true
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "thinkingSteps": {
      "enabled": false,
      "mode": "streaming"
    },
    "workingLine": {
      "enabled": true
    },
    "toolDisplay": {
      "enabled": false
    }
  }
}
